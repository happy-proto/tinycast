    "Add Custom Command" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加自定义命令" } } } },
    "Edit Custom Command" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑自定义命令" } } } },
    "Edit Custom Size" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑自定义尺寸" } } } },
    "New Custom Size" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新建自定义尺寸" } } } },
    "New Quick Action" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新建快捷操作" } } } },
    "No Results" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无结果" } } } },
    "Resizes the window you were last in, on the display it is already on." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在窗口当前所在的显示器上调整你最近使用窗口的大小。" } } } },
    "Search for actions…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索操作…" } } } },
    "Show formatting as you write. The line you are editing shows its Markdown." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入时显示格式效果；正在编辑的行会显示 Markdown 标记。" } } } },
    "Show suggestions" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示建议" } } } },
    "What you open most, while the search field is empty." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索框为空时，显示你最常打开的项目。" } } } },
    "Search sensitivity" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索灵敏度" } } } },
    "Lower finds names from scattered letters." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "调低后可用不连续的字母匹配名称。" } } } },
    "Low" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "低" } } } },
    "Medium" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中" } } } },
    "High" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高" } } } },
    "Suggestions" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "建议" } } } },
    "Version %@" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本 %1$@" } } } },
    "Add MCP Server" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 MCP 服务器" } } } },
    "Add Quick Action" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加快速操作" } } } },
    "Add Quicklink" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加快速链接" } } } },
    "Add Registry" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加注册源" } } } },
    "Add Registry…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加注册源…" } } } },
    "Add a folder or application to search." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加要搜索的文件夹或应用。" } } } },
    "Add a folder to search." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加要搜索的文件夹。" } } } },
    "Add an app to this layout" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "向此布局添加应用" } } } },
    "Add one to make it searchable from the launcher." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加后即可在启动器中搜索。" } } } },
    "Add pattern…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加模式…" } } } },
    "Add quicklinks from a JSON file, skipping any you already have." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从 JSON 文件添加快速链接，并跳过已有项目。" } } } },
    "Add…" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加…" } } } },
    "Advanced" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高级" } } } },
    "AI Providers" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 提供商" } } } },
    "API Connections" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 连接" } } } },
    "API Key" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API 密钥" } } } },
    "Appearance" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "外观" } } } },
    "Apple Shortcuts" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Apple 快捷指令" } } } },
    "Applications" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用" } } } },
    "Applied when an emoji supports skin tones; pastes use it too." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于支持肤色的表情符号，粘贴时也会使用。" } } } },
    "Applied when the default model supports reasoning effort." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认模型支持推理强度时应用。" } } } },
    "Applied when the selected model supports reasoning effort." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选模型支持推理强度时应用。" } } } },
    "Argument" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参数" } } } },
    "Argument name" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参数名称" } } } },
    "Arguments" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "参数" } } } },
    "Ask first when deleting a quicklink from the launcher's Actions menu." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从启动器的操作菜单删除快速链接前先确认。" } } } },
    "Authorization" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "授权" } } } },
    "Auto-switch input source" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动切换输入法" } } } },
    "Automatically join meetings as they start." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议开始时自动加入。" } } } },
    "Background transparency" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "背景透明度" } } } },
