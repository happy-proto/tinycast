    "Access Tinycast needs to work with other apps." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tinycast 与其他应用协作所需的访问权限。" } } } },
    "Accessibility" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能" } } } },
    "Actions" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "操作" } } } },
