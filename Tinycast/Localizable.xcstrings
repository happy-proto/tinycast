    "Size" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "大小" } } } },
    "Source" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来源" } } } },
    "Text Only" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅文本" } } } },
    "This Month" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本月" } } } },
    "This Week" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本周" } } } },
    "Today" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天" } } } },
    "Type" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "类型" } } } },
    "Unpin Entry" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消固定条目" } } } },
    "Words" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单词数" } } } },
    "Yesterday" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "昨天" } } } },
    "Nothing is loaded or sent while it is off." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭时不会加载或发送任何内容。" } } } },
    "Codex and OpenRouter only. Prompts go to a search engine." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅支持 Codex 和 OpenRouter；提示词会发送到搜索引擎。" } } } },
    "Older ones are deleted." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "较早的对话会被删除。" } } } },
    "Conversations stay on this Mac, outside settings backups." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对话仅保存在这台 Mac 上，不包含在设置备份中。" } } } },
    "Off also skips Tinycast's own prompt." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭后也不会发送 Tinycast 自带的提示词。" } } } },
    "Sent before every message, after Tinycast's own. Both are billed each turn." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每条消息前都会发送，排在 Tinycast 自带提示词之后；两者每轮都会计费。" } } } },
    "Uses the command-line tools signed in on this Mac. Their keys are never stored." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac 上已登录的命令行工具，不保存它们的密钥。" } } } },
    "Presets or any OpenAI-compatible endpoint. Keys stay in your login Keychain." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可使用预设服务或任意兼容 OpenAI 的端点；密钥保存在登录钥匙串中。" } } } },
    "Run your shortcuts from the launcher." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从启动器运行快捷指令。" } } } },
    "The ticked items, as one .tinycast file." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将勾选的项目导出为一个 .tinycast 文件。" } } } },
    "Unset matching Raycast shortcuts to avoid conflicts." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消对应的 Raycast 快捷键，以免冲突。" } } } },
    "Calendar access is needed" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要日历访问权限" } } } },
    "Calendar access is off" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日历访问权限已关闭" } } } },
    "Before and after a meeting starts." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议开始前后。" } } } },
    "As they start." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在会议开始时。" } } } },
    "Before joining a meeting." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加入会议前。" } } } },
    "Separate from the Tinycast icon." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与 Tinycast 图标分开显示。" } } } },
    "When the next event appears." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一项日程何时显示。" } } } },
    "Once it has started." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日程开始后。" } } } },
    "Default Browser" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认浏览器" } } } },
    "When no meeting app handles the link." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有会议应用处理链接时使用。" } } } },
    "Recognized on this Mac while idle." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲时在这台 Mac 上识别。" } } } },
    "↵ does this; ⌘↵ does the other." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按 ↵ 执行此操作，按 ⌘↵ 执行另一项操作。" } } } },
    "Removes every clip and image." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除所有剪贴记录和图片。" } } } },
    "No custom commands yet." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有自定义命令。" } } } },
    "Import reads a folder of Raycast script commands." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入会读取包含 Raycast 脚本命令的文件夹。" } } } },
    "List, detail, form, grid, no-view and menu-bar commands, plus preferences, storage and OAuth." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持列表、详情、表单、网格、无界面及菜单栏命令，也支持偏好设置、存储和 OAuth。" } } } },
    "Raycast's OAuth proxy, and its AI, browser and window services." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂不支持 Raycast 的 OAuth 代理及其 AI、浏览器和窗口服务。" } } } },
    "Nothing installed yet." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚未安装任何扩展。" } } } },
    "Uses the Spotlight index, only when you search." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在搜索时使用 Spotlight 索引。" } } } },
    "Home covers its visible folders and cloud drives, never Library." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主目录涵盖可见文件夹和云盘，但不包括资源库。" } } } },
    "No slash matches a name, like *.tmp. A slash matches the path, like **/[Cc]ache/**." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不含斜杠时匹配名称，例如 *.tmp；含斜杠时匹配路径，例如 **/[Cc]ache/**。" } } } },
    "Nothing to offer — their features are off." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用操作；对应功能均已关闭。" } } } },
    "Shown below every search as “Use … with”. Includes quicklinks with an {argument}." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在每次搜索结果下方以“使用…处理”显示，也包括含有 {argument} 的快速链接。" } } } },
    "Off hides all of them and stops their shortcuts." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭后会隐藏全部项目，并禁用对应快捷键。" } } } },
    "Type @slug to address one server. A chat asks before its first tool call." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入 @slug 可指定一个服务器；每次对话首次调用工具前都会征求确认。" } } } },
    "Plain Markdown in a floating editor." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在浮动编辑器中编辑纯 Markdown。" } } } },
    "Formats as you type." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输入时自动排版。" } } } },
    "Create Note" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建笔记" } } } },
    "Act on selected text. Nothing is read until you press a shortcut." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "处理选中的文字；按下快捷键前不会读取内容。" } } } },
    "Accessibility permission required" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要辅助功能权限" } } } },
    "Replace writes into your document, and undo restores it. Preview shows a panel first." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "“替换”会写入文档，可通过撤销恢复；“预览”则会先显示面板。" } } } },
    "Unless an action sets its own." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "除非操作自行指定。" } } } },
    "Separate from AI Chat's, so frequent use needn't bill an API." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "与 AI 聊天使用不同模型，频繁使用也不必每次调用付费 API。" } } } },
    "Apple's translator, on this Mac. A language downloads on first use." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac 上的 Apple 翻译；首次使用某种语言时需要下载。" } } } },
    "Open Language & Region" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开“语言与地区”" } } } },
    "Dismiss" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } } } },
    "Changes can't be saved: the database couldn't be opened. Its file is untouched." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法保存更改：数据库未能打开，原文件保持不变。" } } } },
    "Where the app supports it." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅在应用支持时生效。" } } } },
    "For links that use {selection}." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适用于包含 {selection} 的链接。" } } } },
    "From the launcher's Actions menu." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从启动器的“操作”菜单使用。" } } } },
    "From a JSON file; duplicates are skipped." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从 JSON 文件导入；跳过重复项目。" } } } },
    "To a JSON file." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出为 JSON 文件。" } } } },
    "Shortcuts still work when hidden." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐藏后快捷键仍可使用。" } } } },
    "After the launcher closes." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动器关闭后。" } } } },
    "When the search field is empty." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索栏为空时。" } } } },
    "While the launcher is open." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动器打开时。" } } } },
    "Launch them with ⌘1–⌘5." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 ⌘1–⌘5 启动它们。" } } } },
    "Drag the strip above the search field." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖动搜索栏上方的细条即可移动。" } } } },
    "Remapping needs Accessibility access." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按键重映射需要辅助功能权限。" } } } },
    "With a decimal comma, ; separates arguments." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用逗号作为小数点时，用 ; 分隔参数。" } } } },
    "Learned privately from the results you pick." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "根据你选择的结果在本机学习排序。" } } } },
    "Window mode" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口模式" } } } },
    "Switch windows and search menu bar items." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "切换窗口并搜索菜单栏项目。" } } } },
    "Pastes into the app you were using." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "粘贴到你刚才使用的应用。" } } } },
    "Finds the join link for your next meeting." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查找下一场会议的加入链接。" } } } },
    "Keyword expansion needs Accessibility access." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关键词展开需要辅助功能权限。" } } } },
    "Launcher search still works." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启动器搜索仍可使用。" } } } },
    "Plain Markdown files." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纯 Markdown 文件。" } } } },
    "Between tiled windows and screen edges." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "平铺窗口之间及窗口与屏幕边缘之间。" } } } },
    "Remap one key to %@ held together." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将一个按键重映射为同时按下 %@。" } } } },
    "%@ sends %@, shown as ✦ in shortcuts." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按下 %@ 会发送 %@，在快捷键中显示为 ✦。" } } } },
    "Compact" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "紧凑" } } } },
    "Expanded" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "展开" } } } },
    "Record Hotkey" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录制快捷键" } } } },
    "today's" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天的" } } } },
    "today's and tomorrow's" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天和明天的" } } } },
    "Tinycast reads %@ events to find join links. Nothing leaves this Mac." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Tinycast 会读取%1$@事件以查找加入链接。所有数据都不会离开这台 Mac。" } } } },
    "When %@ is pressed alone." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单独按下 %@ 时。" } } } },
    "简体中文" : { "extractionState" : "stale", "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "简体中文" } } } }
  },
  "version" : "1.0"
}
